{
  "id": "/qr-code-generator/",
  "name": "Revu QR",
  "short_name": "Revu QR",
  "description": "QR-Codes erstellen – vCard, WiFi, E-Mail, Logo, PNG und SVG. Alles läuft lokal im Browser. Create QR codes locally – no server, no tracking.",
  "lang": "de",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "launch_handler": { "client_mode": "focus-existing" },
  "orientation": "any",
  "background_color": "#ffffff",
  "theme_color": "#667eea",
  "categories": ["utilities", "productivity"],
  "icons": [
    {
      "src": "icons/icon-192.png",
